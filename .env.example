# Jev (TypeSafe) — keep server-side only; never ship to the static build.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# Laya (local laya-serve, same wire protocol as Jev)
LAYA_BASE_URL=http://localhost:8000
LAYA_MODEL=english

# Salt for sha256(salt + steamid). Raw author IDs are never stored.
AUTHOR_HASH_SALT=change-me

# Spend guard: pre-flight blocks runs above this unless confirmed.
MAX_RUN_COST_USD=2
