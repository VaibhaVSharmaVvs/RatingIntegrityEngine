          "type": "integer"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "KEEP",
              "DOWNWEIGHT",
              "FLAG",
              "EXCLUDE"
            ]
          },
          "type": "object"
