      "required": [
        "type",
        "name",
        "status"
      ],
      "title": "StageEvent",
      "type": "object"
    },
    "SteamFetchRequest": {
      "properties": {
        "appid": {
          "type": "integer"
        },
        "from": {
          "description": "YYYY-MM-DD, UTC inclusive",
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "language": {
          "default": "english",
          "type": "string"
        },
        "sample_n": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
