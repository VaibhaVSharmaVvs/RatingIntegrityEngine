          ]
        },
        "n_eff": {
          "type": "number"
        },
        "rating_scale": {
          "type": "string"
        },
        "steam_label_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
