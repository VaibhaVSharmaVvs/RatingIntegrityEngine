      },
      "required": [
        "appid",
        "from",
        "to"
      ],
      "title": "SteamFetchRequest",
      "type": "object"
    },
    "TimelineBucket": {
      "properties": {
        "day": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "mean_rating": {
          "type": "number"
        }
