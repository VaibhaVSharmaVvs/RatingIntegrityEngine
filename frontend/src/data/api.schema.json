        "steam_label_adjusted": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cost_usd": {
          "type": "number"
        },
        "tokens_in": {
          "type": "integer"
        },
        "elapsed_s": {
          "type": "number"
        },
        "reviews_per_s": {
          "type": "number"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
